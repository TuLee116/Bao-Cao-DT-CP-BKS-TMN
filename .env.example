# Railway tự cấp PORT. Khi deploy chỉ cần đặt DATABASE_URL (và nên đặt SETUP_TOKEN).
PORT=3000

# Kết nối PostgreSQL. Trên Railway: ${{Postgres.DATABASE_URL}}
# Để trống = chạy thử bằng bộ nhớ tạm (mất dữ liệu khi tắt).
DATABASE_URL=

# (Khuyến nghị) Mã bảo vệ trang Khởi tạo lần đầu.
# Có mã này mới tạo được tài khoản Quản trị đầu tiên -> người lạ không chiếm được hệ thống.
SETUP_TOKEN=
